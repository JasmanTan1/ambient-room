<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- The client separately requires explicit consent before permitting HTTP. -->
    <application android:label="Ambient Room" android:theme="@android:style/Theme.Material.NoActionBar"
        android:icon="@drawable/room_icon" android:banner="@drawable/room_banner"
        android:allowBackup="false" android:fullBackupContent="false" android:usesCleartextTraffic="true">
        <activity android:name=".BgmActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
